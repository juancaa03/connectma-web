---
// Plantilla de cada resultado del TecnoChallenge.
// Las páginas .md de src/pages la usan con: layout: ../layouts/Resultado.astro
import Base from "./Base.astro";
import { resultados } from "../data/sitio.js";
const { frontmatter } = Astro.props;
const n = Number(String(frontmatter.resultado).split("–")[0]);
const i = resultados.findIndex((r) => r.n === n);
const ant = resultados.slice(0, i).reverse().find((r) => !r.href.includes("#") && r.href !== resultados[i]?.href);
const sig = resultados.slice(i + 1).find((r) => !r.href.includes("#") && r.href !== resultados[i]?.href);
---
<Base titulo={frontmatter.titulo} descripcion={frontmatter.entradilla}>
  <article class="wrap res">
    <header class="res-head">
      <p class="res-n">Resultado {frontmatter.resultado}{frontmatter.fase && ` · ${frontmatter.fase}`}</p>
      <h1>{frontmatter.titulo}</h1>
      {frontmatter.entradilla && <p class="lead">{frontmatter.entradilla}</p>}
      {frontmatter.autoria && <p class="autoria">Redactado por {frontmatter.autoria}</p>}
    </header>
    <div class="prose"><slot /></div>
    <nav class="res-nav" aria-label="Resultados">
      {ant ? <a href={ant.href}>Anterior: {ant.titulo}</a> : <span />}
      {sig && <a href={sig.href}>Siguiente: {sig.titulo}</a>}
    </nav>
  </article>
</Base>

<style>
  .res { padding-block: clamp(2.5rem, 6vw, 5rem); }
  .res-head { border-bottom: 2px solid var(--ink); padding-bottom: 2rem; margin-bottom: 1rem; }
  .res-n { font-weight: 600; color: var(--sea); }
  .autoria { font-size: var(--step--1); color: var(--ink-soft); margin: 0; }
  .res-nav { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--line); font-weight: 600; }
</style>
