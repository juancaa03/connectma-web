---
import Base from "../layouts/Base.astro";
import Mapa from "../components/Mapa.astro";
import { sitio } from "../data/sitio.js";

const acciones = [
  { estado: "POTENCIAL", titulo: "Generar informe para emprendedor", texto: "Un PDF de una página con los vecinos de la zona, su tendencia y los tipos de negocio por debajo de lo normal. El técnico lo entrega en la primera cita, en lugar de mandar al emprendedor al GeoVisor." },
  { estado: "DECLIVE", titulo: "Proponer para Aixequem Persianes", texto: "Las zonas en declive o en riesgo pasan a una lista de candidatas para las ayudas del año, que hoy se concentran en el centro." },
  { estado: "EN RIESGO", titulo: "Marcar local vacío", texto: "Cada ficha ya lista los locales cerrados desde 2023 sin actividad nueva, sacados del registro de prospección. La técnica añade los que ve a pie de calle." },
  { estado: "CONSOLIDADA", titulo: "Asesor por tipo de negocio", texto: "Quien emprende indica qué negocio quiere abrir y, si quiere, en qué barrio. Recibe las zonas donde falta, el motivo y los locales cerrados cercanos. No se guarda nada." },
];
---
<Base titulo="Solución" descripcion="Radar de zonas con potencial y en declive comercial en Mataró, con una acción para cada zona.">
  <section class="intro">
    <div class="wrap intro-grid">
      <div>
        <p class="res-n">Resultado 7</p>
        <h1>Un radar que propone qué hacer en cada zona</h1>
        <p class="lead">ConnectMA clasifica las 72 secciones urbanas de Mataró según si ganan o pierden vecinos y si tienen el comercio de proximidad que les corresponde. Cada estado lleva a una acción concreta del Ajuntament.</p>
        <div class="ctas">
          <a class="btn" href={sitio.appUrl}>Probar el prototipo</a>
          <a class="btn ghost" href={sitio.metodologiaUrl}>Leer la metodología</a>
        </div>
      </div>
      <Mapa compacto />
    </div>
  </section>

  <section class="estados">
    <div class="wrap">
      <h2>Cuatro estados, dos preguntas</h2>
      <p class="lead">¿La zona gana o pierde demanda (vecinos y, si la población está estable, renta, frente a la zona típica de Mataró)? ¿Tiene el comercio de proximidad que le corresponde? Las zonas con algo menos de comercio y sin tendencia clara salen como "Sin señal clara".</p>
      <div class="matriz" role="table" aria-label="Estados según demanda y actividad">
        <div role="row" class="m-row">
          <span role="columnheader"></span>
          <span role="columnheader" class="m-h">Poco comercio</span>
          <span role="columnheader" class="m-h">Comercio suficiente</span>
        </div>
        <div role="row" class="m-row">
          <span role="rowheader" class="m-h">Demanda que crece o se mantiene</span>
          <div role="cell" class="m-c st-POTENCIAL"><strong>Potencial</strong><span>Muy poca oferta de algún tipo de negocio para los vecinos que hay o que llegan.</span></div>
          <div role="cell" class="m-c st-CONSOLIDADA"><strong>Bien servida</strong><span>Funciona. Vigilancia normal.</span></div>
        </div>
        <div role="row" class="m-row">
          <span role="rowheader" class="m-h">Demanda que cae</span>
          <div role="cell" class="m-c st-DECLIVE"><strong>Declive</strong><span>Pierde vecinos y ya le falta comercio.</span></div>
          <div role="cell" class="m-c st-EN_RIESGO"><strong>En riesgo</strong><span>Hoy tiene comercio, mañana menos clientes.</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="acciones">
    <div class="wrap">
      <h2>De ver a actuar</h2>
      <p class="lead">Un mapa que solo se mira no cambia nada. Cada ficha del radar termina en una de estas acciones.</p>
      <ul class="acc">
        {acciones.map((a) => (
          <li class={`st-${a.estado.replace(" ", "_")}`}>
            <h3>{a.titulo}</h3>
            <p>{a.texto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
<section class="encaje">
    <div class="wrap">
      <h2>Lo que pidió Comerç, y cómo lo cubrimos</h2>
      <p class="lead">En la llamada del 20 de octubre, el servicio de Comerç nos dijo qué necesita. Esto es lo que el prototipo ya resuelve con datos abiertos y el registro de prospección que nos cedió el Ajuntament, y lo que mejora cuando esos datos se conectan en continuo.</p>
      <div class="table-scroll">
        <table class="tabla-encaje">
          <thead><tr><th>Lo que pidieron</th><th>En el prototipo (hoy)</th><th>En el servicio (datos conectados)</th></tr></thead>
          <tbody>
            <tr><td><strong>Decidir la política comercial</strong> desde el Ajuntament</td><td>Bandeja priorizada; cada zona termina en una acción: informe, Aixequem Persianes o marcar local vacío</td><td>Seguimiento año a año del efecto de cada ayuda</td></tr>
            <tr><td><strong>Tipología:</strong> qué actividad falta y dónde</td><td>Tipos de proximidad muy por debajo de lo normal, confirmados con tres radios, con el registro de prospección y descontando mercados y grandes superficies</td><td>Censo vivo con las aperturas que ya comunica cada negocio</td></tr>
            <tr><td><strong>Zonas con potencial</strong> y la "mancha de aceite"</td><td>Zonas que ganan vecinos con poca oferta, y tipos que funcionan en la zona de al lado y aquí casi no hay</td><td>Con el histórico de la prospección: qué actividad está <em>creciendo</em>, no solo dónde se concentra</td></tr>
            <tr><td><strong>Zonas en declive:</strong> calles que se vacían</td><td>Cierres reales desde 2023 del registro de prospección y aviso de rotación alta; 465 locales cerrados sin actividad nueva; aviso de obra nueva (Catastro) para no confundir una zona en obras con una que se vacía</td><td>Cierres al día y padrón actualizado cada mes</td></tr>
            <tr><td><strong>Afluencia</strong></td><td>Lo que atrae gente a cada zona: estación, paradas de bus, centros educativos y de salud, mercados</td><td>Contadores de peatones y datos de movilidad</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="geovisor">
    <div class="wrap dos">
      <div>
        <h2>Frente al GeoVisor</h2>
        <p class="lead">El GeoVisor dice qué hay. ConnectMA dice qué falta, dónde y qué puede hacer el Ajuntament.</p>
        <p>No lo sustituye: lo usa como fuente. El detalle de cada local y las demás capas urbanísticas siguen en el GeoVisor.</p>
      </div>
      <dl class="comparacion">
        <div><dt>Para el Ajuntament</dt><dd><span>GeoVisor:</span> capas que hay que consultar una a una, sin tendencia ni comparación.<br /><span>ConnectMA:</span> zonas priorizadas, el motivo y la herramienta para cada una.</dd></div>
        <div><dt>Para quien emprende</dt><dd><span>GeoVisor:</span> un mapa que interpreta solo.<br /><span>ConnectMA:</span> un informe de una página y un asesor por tipo de negocio, en la primera cita con el técnico.</dd></div>
      </dl>
    </div>
  </section>

  <section class="ruta-servicio">
    <div class="wrap">
      <h2>Del piloto al servicio</h2>
      <ol class="fases">
        <li>
          <h3>Piloto: datos públicos</h3>
          <p>Lo que hay hoy en el prototipo: censo de actividades del GeoVisor, registro de prospección del Ajuntament, INE, Catastro y OpenStreetMap. Se puede probar con Comerç en la próxima convocatoria de Aixequem Persianes.</p>
        </li>
        <li>
          <h3>Servicio: datos que el Ajuntament ya tiene</h3>
          <p>Padrón agregado por sección (población del mes, no de hace dos años) y el registro de aperturas y cierres conectado en continuo, no una foto al año.</p>
        </li>
        <li>
          <h3>Validación</h3>
          <p>Con el histórico, comprobar hacia atrás si el radar habría avisado de las zonas que luego perdieron comercio. Es la prueba de que funciona.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="prototipo" id="prototipo">
    <div class="wrap dos">
      <div>
        <p class="res-n">Resultado 7</p>
        <h2>El prototipo</h2>
        <p class="lead">Fichas de cada zona filtrables por barrio, estado y tipo de negocio que falta, con el mapa como segunda vista y las acciones funcionando.</p>
        <a class="btn" href={sitio.appUrl}>Probar el prototipo</a>
      </div>
      <ul class="proto-lista"><li><strong>Bandeja:</strong> las zonas por prioridad, con lo que dicen los datos de la ciudad arriba.</li><li><strong>Ficha e informe:</strong> qué falta, cierres desde 2023, locales vacíos y PDF para quien emprende.</li><li><strong>Mapa:</strong> las 72 zonas por estado.</li><li><strong>Asesor:</strong> dónde encaja un tipo de negocio.</li></ul>
    </div>
  </section>

  <section class="ods">
    <div class="wrap">
      <h2>Impacto y ODS</h2>
      <div class="ods-grid">
        <article>
          <h3>ODS 8 · Trabajo decente y crecimiento económico</h3>
          <p>Ayuda a abrir negocios donde hay demanda y a sostener los que están en zonas que pierden vecinos.</p>
        </article>
        <article>
          <h3>ODS 11 · Ciudades y comunidades sostenibles</h3>
          <p>Barrios con servicios a 5 minutos a pie: más vida en la calle y menos dependencia del centro y de los centros comerciales.</p>
        </article>
        <article>
          <h3>Impacto ambiental</h3>
          <p>Cada compra que se hace a pie en el barrio es un desplazamiento en coche menos.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="pendientes">
    <div class="wrap dos">
      <div id="ecocanvas">
        <p class="res-n">Resultado 6</p>
        <h2>EcoCanvas</h2>
        <div class="pendiente">Se completa el sábado 24 de octubre.</div>
      </div>
      <div id="pitch">
        <p class="res-n">Resultado 9</p>
        <h2>Co-pitch</h2>
        <div class="pendiente">Presentación del domingo 25 de octubre.</div>
      </div>
    </div>
  </section>
</Base>

<style>
  .res-n { font-weight: 600; color: var(--sea); }
  .intro { padding-top: clamp(2rem, 5vw, 4rem); }
  .intro-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }
  .dos { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (max-width: 860px) { .intro-grid, .dos { grid-template-columns: 1fr; } }

  .estados { background: var(--paper); border-block: 1px solid var(--line); }
  .matriz { display: grid; gap: 0.6rem; margin-top: 2rem; max-width: 900px; }
  .m-row { display: grid; grid-template-columns: 11rem 1fr 1fr; gap: 0.6rem; }
  .m-h { font-weight: 600; font-size: var(--step--1); color: var(--ink-soft); align-self: end; padding-bottom: 0.3rem; }
  .m-row .m-h:first-child { align-self: center; }
  .m-c { background: color-mix(in srgb, var(--c) 30%, white); border-left: 6px solid var(--c); padding: 1.1rem 1.2rem; min-height: 7rem; display: grid; align-content: start; gap: 0.3rem; }
  .m-c strong { font-size: var(--step-1); }
  .m-c span { color: var(--ink-soft); font-size: var(--step--1); }
  @media (max-width: 640px) { .m-row { grid-template-columns: 6.5rem 1fr 1fr; } .m-c { padding: 0.8rem; } }

  .acc { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 3rem; }
  @media (max-width: 760px) { .acc { grid-template-columns: 1fr; } }
  .acc li { border-top: 3px solid var(--c); padding: 1.3rem 0 1rem; }
  .acc p { color: var(--ink-soft); }

  .prototipo { background: var(--ink); color: #e3edf5; }
  .prototipo .lead { color: #c4d4e2; }
  .prototipo .res-n { color: var(--sun); }
  .prototipo .btn { background: var(--sun); border-color: var(--sun); color: var(--ink); margin-top: 1rem; }
  .prototipo .pendiente { background: transparent; color: #c4d4e2; border-color: #3c5373; min-height: 14rem; display: grid; place-items: center; }

  .ods-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 1.5rem; }
  @media (max-width: 860px) { .ods-grid { grid-template-columns: 1fr; } }
  .ods-grid article { border-top: 2px solid var(--ink); padding-top: 1rem; }
  .ods-grid p { color: var(--ink-soft); }

  .encaje { background: var(--paper); border-block: 1px solid var(--line); }
  .tabla-encaje { width: 100%; border-collapse: collapse; margin-top: 1.5rem; font-size: var(--step--1); min-width: 720px; }
  .tabla-encaje th, .tabla-encaje td { text-align: left; vertical-align: top; padding: 0.9rem 1rem; border-bottom: 1px solid var(--line); }
  .tabla-encaje th { font-weight: 700; border-bottom: 2px solid var(--ink); }
  .tabla-encaje td:first-child { width: 24%; }
  .tabla-encaje td:last-child { color: var(--ink-soft); }
  .comparacion { margin: 0; display: grid; gap: 1.5rem; }
  .comparacion dt { font-weight: 800; font-size: var(--step-1); margin-bottom: 0.4rem; }
  .comparacion dd { margin: 0; line-height: 1.6; }
  .comparacion dd span { font-weight: 700; }
  .ruta-servicio { background: var(--paper); border-top: 1px solid var(--line); }
  .fases { list-style: none; counter-reset: fase; padding: 0; margin: 2rem 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .fases li { counter-increment: fase; border-top: 3px solid var(--sea); padding-top: 1rem; }
  .fases li:first-child { border-color: var(--sun); }
  .fases h3::before { content: counter(fase) ". "; color: var(--sea); }
  .fases p { color: var(--ink-soft); }
  @media (max-width: 860px) { .fases { grid-template-columns: 1fr; } }
  .proto-lista { margin: 0; padding-left: 1.2rem; line-height: 1.6; }
  .proto-lista li { margin-bottom: 0.6rem; }
</style>
